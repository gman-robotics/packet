#!/usr/bin/env bash
# Verification harness for the packet CLI. Invoked from .cursor/skills/verify-packet/SKILL.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
CONTROL_PACKET="${SCRIPT_DIR}/$(basename "${BASH_SOURCE[0]}")"

PACKET_VERIFY_MARKER=".packet-verify-owned"
VERIFY_TMP_PREFIX="/tmp/packet-verify-"
# On macOS /tmp is a symlink to /private/tmp; compare realpaths against the resolved prefix.
VERIFY_TMP_PREFIX_REAL="$(cd /tmp && pwd -P)/packet-verify-"

ARTIFACTS_DIR=""
CACHE_DIR=""

realpath_safe() {
  local path="$1"
  if [[ -e "$path" ]]; then
    realpath "$path"
  elif realpath -m / >/dev/null 2>&1; then
    realpath -m "$path"
  else
    # BSD realpath (macOS) has no -m; resolve the non-existent path portably.
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$path"
  fi
}

# strip_verify_prefix PATH: print PATH with the verify prefix removed, or fail.
strip_verify_prefix() {
  local real="$1"
  if [[ "$real" == "${VERIFY_TMP_PREFIX_REAL}"* ]]; then
    echo "${real#${VERIFY_TMP_PREFIX_REAL}}"
  elif [[ "$real" == "${VERIFY_TMP_PREFIX}"* ]]; then
    echo "${real#${VERIFY_TMP_PREFIX}}"
  else
    return 1
  fi
}

# is_under_verify_tmp_root PATH [allow_root]
# True when PATH is strictly inside /tmp/packet-verify-<run-id>/. With allow_root=1 the
# run root itself (/tmp/packet-verify-<run-id>) also passes; cache/scratch never pass it.
is_under_verify_tmp_root() {
  local real="$1"
  local allow_root="${2:-0}"
  local rest
  rest="$(strip_verify_prefix "$real")" || return 1
  [[ -n "$rest" ]] || return 1
  [[ "$rest" != *".."* ]] || return 1
  local run_segment="${rest%%/*}"
  [[ -n "$run_segment" ]] || return 1
  if [[ "$rest" != */* ]]; then
    [[ "$allow_root" == "1" ]] || return 1
  fi
  return 0
}

run_root_for_path() {
  local real="$1"
  if ! is_under_verify_tmp_root "$real" 1; then
    return 1
  fi
  local rest
  rest="$(strip_verify_prefix "$real")" || return 1
  local run_segment="${rest%%/*}"
  echo "${real%"$rest"}${run_segment}"
}

marker_path_for_root() {
  echo "$1/$PACKET_VERIFY_MARKER"
}

read_run_id_from_marker() {
  local root="$1"
  local marker
  marker="$(marker_path_for_root "$root")"
  [[ -f "$marker" ]] || return 1
  local line
  line="$(grep -E '^run_id=' "$marker" | head -1 || true)"
  [[ -n "$line" ]] || return 1
  PACKET_VERIFY_RUN_ID="${line#run_id=}"
  export PACKET_VERIFY_RUN_ID
}

write_ownership_marker() {
  local root="$1"
  mkdir -p "$root"
  cat >"$(marker_path_for_root "$root")" <<EOF
run_id=${PACKET_VERIFY_RUN_ID}
repo_root=${REPO_ROOT}
created_by=control-packet
EOF
}

establish_verify_paths() {
  local sub="${1:-}"

  if [[ -n "${PACKET_VERIFY_RUN_ID:-}" ]]; then
    local expected_root="${VERIFY_TMP_PREFIX}${PACKET_VERIFY_RUN_ID}"
    if [[ -z "${PACKET_VERIFY_ROOT:-}" ]]; then
      export PACKET_VERIFY_ROOT="$expected_root"
    else
      local root_real expected_real
      root_real="$(realpath_safe "$PACKET_VERIFY_ROOT")"
      expected_real="$(realpath_safe "$expected_root")"
      if [[ "$root_real" != "$expected_real" ]]; then
        export PACKET_VERIFY_ROOT="$expected_real"
      else
        export PACKET_VERIFY_ROOT="$root_real"
      fi
    fi
  elif [[ -n "${PACKET_VERIFY_ROOT:-}" ]]; then
    local root_real
    root_real="$(realpath_safe "$PACKET_VERIFY_ROOT")"
    if ! read_run_id_from_marker "$root_real"; then
      if [[ "$sub" == launch ]]; then
        PACKET_VERIFY_RUN_ID="$(date +%s)-$$"
        export PACKET_VERIFY_RUN_ID
      else
        echo "FAIL: PACKET_VERIFY_RUN_ID unset and no ownership marker under $PACKET_VERIFY_ROOT (run launch first)" >&2
        return 1
      fi
    fi
    export PACKET_VERIFY_ROOT="$root_real"
  elif [[ "$sub" == launch ]]; then
    PACKET_VERIFY_RUN_ID="$(date +%s)-$$"
    export PACKET_VERIFY_RUN_ID
    export PACKET_VERIFY_ROOT="${VERIFY_TMP_PREFIX}${PACKET_VERIFY_RUN_ID}"
  else
    echo "FAIL: set PACKET_VERIFY_RUN_ID or run launch / eval \"\$(${CONTROL_PACKET} env)\"" >&2
    return 1
  fi

  local root_real default_artifacts default_cache
  root_real="$(realpath_safe "$PACKET_VERIFY_ROOT")"
  export PACKET_VERIFY_ROOT="$root_real"
  default_artifacts="$root_real/artifacts"
  default_cache="$root_real/cache"

  if [[ -n "${PACKET_VERIFY_ARTIFACTS:-}" ]]; then
    ARTIFACTS_DIR="${PACKET_VERIFY_ARTIFACTS}"
  else
    ARTIFACTS_DIR="$default_artifacts"
  fi

  if [[ -n "${PACKET_VERIFY_CACHE:-}" ]]; then
    local cache_real
    cache_real="$(realpath_safe "$PACKET_VERIFY_CACHE")"
    if [[ "$cache_real" == "$root_real"/* ]]; then
      CACHE_DIR="$cache_real"
    else
      echo "WARN: ignoring PACKET_VERIFY_CACHE outside verify root ($cache_real)" >&2
      CACHE_DIR="$default_cache"
    fi
  else
    CACHE_DIR="$default_cache"
  fi
}

assert_owned_deletable_path() {
  local label="$1"
  local path="$2"
  local allow_root="${3:-0}"
  if [[ -z "$path" ]]; then
    echo "cleanup: refuse empty $label path" >&2
    return 1
  fi
  local real
  real="$(realpath_safe "$path")"
  if ! is_under_verify_tmp_root "$real" "$allow_root"; then
    echo "cleanup: refuse $label outside ${VERIFY_TMP_PREFIX}*: $real" >&2
    return 1
  fi
  local run_root
  run_root="$(run_root_for_path "$real")"
  local marker
  marker="$(marker_path_for_root "$run_root")"
  if [[ ! -f "$marker" ]]; then
    echo "cleanup: refuse $label without ownership marker at $marker" >&2
    return 1
  fi
  return 0
}

packet_bin() {
  if command -v packet >/dev/null 2>&1; then
    command -v packet
    return 0
  fi
  if [[ -x "${HOME}/.local/bin/packet" ]]; then
    echo "${HOME}/.local/bin/packet"
    return 0
  fi
  echo "packet CLI not found on PATH (run: pip install -e \".[dev]\")" >&2
  return 127
}

packet_resolves_to_repo() {
  local _pkt="$1"
  local editable_root
  editable_root="$(python3 -c "
import json
import pathlib
import importlib.metadata as m

dist = m.distribution('packet-dl')
raw = dist.read_text('direct_url.json')
data = json.loads(raw)
url = data.get('url', '')
if not url.startswith('file://'):
    raise SystemExit(1)
import urllib.request
print(pathlib.Path(urllib.request.url2pathname(url.removeprefix('file://'))).resolve())
" 2>/dev/null)" || return 1
  local repo_real
  repo_real="$(realpath_safe "$REPO_ROOT")"
  [[ "$editable_root" == "$repo_real" ]] || return 1
  # The editable metadata can point here while a copied site-packages/packet shadows it
  # (pyproject force-include copies src/packet into site-packages on `pip install -e`).
  # Check where `import packet` really loads from.
  local imported
  imported="$(cd / && python3 -c "import packet, pathlib; print(pathlib.Path(packet.__file__).resolve().parent)" 2>/dev/null)" || return 1
  if [[ "$imported" != "$repo_real/src/packet" ]]; then
    echo "FAIL: import packet loads $imported, not $repo_real/src/packet (stale copy shadowing the editable install; move it aside)" >&2
    return 1
  fi
}

ensure_path() {
  export PATH="${HOME}/.local/bin:${PATH}"
}

cmd_doctor() {
  ensure_path
  local pkt
  pkt="$(packet_bin)" || return 1
  if [[ ! -f "$REPO_ROOT/pyproject.toml" ]]; then
    echo "FAIL: expected repo root at $REPO_ROOT (missing pyproject.toml)" >&2
    return 1
  fi
  if ! "$pkt" --help >/dev/null 2>&1; then
    echo "FAIL: packet --help failed" >&2
    return 1
  fi
  if ! packet_resolves_to_repo "$pkt"; then
    echo "FAIL: packet import does not resolve to this checkout ($REPO_ROOT/src/packet)" >&2
    return 1
  fi
  local ver
  ver="$(python3 -c "import importlib.metadata as m; print(m.version('packet-dl'))" 2>/dev/null || echo unknown)"
  # OCR readiness (read-only): LightOn needs mlx-vlm (Apple silicon) and its pinned
  # weights in the Hugging Face cache; Paddle is the fallback. No downloads here.
  local ocr
  ocr="$(python3 - <<'PY' 2>/dev/null || echo 'ocr_lighton: unknown'
import importlib.util, platform
from packet.backends import LightOnExtractor as L
mlx = importlib.util.find_spec("mlx_vlm") is not None
weights = False
try:
    from huggingface_hub import snapshot_download
    snapshot_download(L.model, revision=L.revision, local_files_only=True)
    weights = True
except Exception:
    pass
paddle = importlib.util.find_spec("paddleocr") is not None
print(f"ocr_lighton: {'ready' if mlx and weights else 'missing-mlx' if not mlx else 'missing-weights'}")
print(f"ocr_paddle: {'installed' if paddle else 'missing'}")
print(f"machine: {platform.system()}-{platform.machine()}")
PY
)"
  cat <<EOF
ok: true
repo_root: $REPO_ROOT
packet: $pkt
package_version: $ver
verify_root: $PACKET_VERIFY_ROOT
artifacts_dir: $ARTIFACTS_DIR
cache_dir: $CACHE_DIR
run_id: $PACKET_VERIFY_RUN_ID
$ocr
EOF
}

cmd_launch() {
  ensure_path
  cd "$REPO_ROOT"
  if ! packet_bin >/dev/null 2>&1; then
    python3 -m pip install -e ".[dev]" -q
    ensure_path
  fi
  local pkt
  pkt="$(packet_bin)" || return 1
  if ! packet_resolves_to_repo "$pkt"; then
    echo "FAIL: packet is not this checkout (see above; if no reason is shown, run pip install -e \".[dev]\" from $REPO_ROOT)" >&2
    return 1
  fi
  mkdir -p "$ARTIFACTS_DIR" "$CACHE_DIR"
  write_ownership_marker "$PACKET_VERIFY_ROOT"
  cmd_doctor
}

cmd_cli() {
  ensure_path
  local pkt
  pkt="$(packet_bin)" || return 1
  mkdir -p "$ARTIFACTS_DIR"
  if [[ $# -lt 1 ]]; then
    echo "usage: control-packet cli -- <packet-args...>" >&2
    return 2
  fi
  if [[ "$1" != "--" ]]; then
    echo "usage: control-packet cli -- <packet-args...>" >&2
    return 2
  fi
  shift
  local label="${PACKET_VERIFY_CMD_LABEL:-packet}"
  local out_base="$ARTIFACTS_DIR/${label}"
  set +e
  "$pkt" "$@" >"${out_base}.stdout" 2>"${out_base}.stderr"
  local ec=$?
  set -e
  echo "$ec" >"${out_base}.exitcode"
  echo "exit_code=$ec"
  echo "stdout=${out_base}.stdout"
  echo "stderr=${out_base}.stderr"
  # Exit with the same code as packet so shell && / set -e honor failures.
  return "$ec"
}

cmd_materialize_fixtures() {
  ensure_path
  mkdir -p "$CACHE_DIR"
  local pkt
  pkt="$(packet_bin)" || return 1
  # packet eval writes builtin PDFs before gates and exits 1 when a gate fails.
  # Inspect and parse only need the PDFs, so a gate failure is not a materialize failure.
  set +e
  "$pkt" eval --dir "$CACHE_DIR" >/dev/null
  local ec=$?
  set -e
  local name
  for name in text-layer multi-doc shared-header scan; do
    if [[ ! -f "$CACHE_DIR/builtin/${name}.pdf" ]]; then
      echo "FAIL: packet eval did not write builtin PDFs (exit ${ec})" >&2
      return 1
    fi
  done
  echo "cache_dir=$CACHE_DIR"
  ls -1 "$CACHE_DIR/builtin/"*.pdf 2>/dev/null || true
}

# make-scan [name]: an image-only copy of a builtin fixture (default multi-doc), so the
# pages classify SCAN and only OCR can read them. Written to $CACHE_DIR/scan-<name>.pdf.
cmd_make_scan() {
  local name="${1:-multi-doc}"
  if [[ "$name" == */* ]]; then
    echo "make-scan: fixture name must not contain '/': $name" >&2
    return 2
  fi
  if ! python3 -c "import PIL, pypdfium2" 2>/dev/null; then
    echo "make-scan: needs Pillow and pypdfium2 in the python3 on PATH (the packet env)" >&2
    return 1
  fi
  local src
  src="$(cmd_fixture "$name")" || return 2
  local out="$CACHE_DIR/scan-${name}.pdf"
  python3 - "$src" "$out" <<'PY' || return 1
import sys
import pypdfium2 as pdfium
src, out = sys.argv[1], sys.argv[2]
doc = pdfium.PdfDocument(src)
imgs = [doc[i].render(scale=150 / 72).to_pil().convert("RGB") for i in range(len(doc))]
imgs[0].save(out, save_all=True, append_images=imgs[1:], resolution=150)
PY
  echo "$out"
}

cmd_fixture() {
  local name="${1:-text-layer}"
  if [[ ! -d "$CACHE_DIR/builtin" ]]; then
    cmd_materialize_fixtures >/dev/null
  fi
  local pdf="$CACHE_DIR/builtin/${name}.pdf"
  if [[ ! -f "$pdf" ]]; then
    echo "not found: $pdf (known: text-layer multi-doc shared-header scan)" >&2
    return 2
  fi
  echo "$pdf"
}

cmd_env() {
  mkdir -p "$ARTIFACTS_DIR" "$CACHE_DIR"
  if [[ ! -f "$(marker_path_for_root "$PACKET_VERIFY_ROOT")" ]]; then
    write_ownership_marker "$PACKET_VERIFY_ROOT"
  fi
  printf 'export PACKET_VERIFY_RUN_ID=%q\n' "$PACKET_VERIFY_RUN_ID"
  printf 'export PACKET_VERIFY_ROOT=%q\n' "$PACKET_VERIFY_ROOT"
  printf 'export PACKET_VERIFY_ARTIFACTS=%q\n' "$ARTIFACTS_DIR"
  printf 'export PACKET_VERIFY_CACHE=%q\n' "$CACHE_DIR"
}

cmd_cleanup() {
  # Always delete canonical paths under the verify root (never honor external CACHE overrides).
  local cache="${PACKET_VERIFY_ROOT}/cache"
  if [[ -n "${PACKET_VERIFY_CACHE:-}" ]]; then
    local env_cache_real canonical_cache_real
    env_cache_real="$(realpath_safe "$PACKET_VERIFY_CACHE")"
    canonical_cache_real="$(realpath_safe "$cache")"
    if [[ "$env_cache_real" != "$canonical_cache_real" ]]; then
      assert_owned_deletable_path "PACKET_VERIFY_CACHE" "$env_cache_real" || return 1
      if [[ -d "$env_cache_real" ]]; then
        rm -rf "$env_cache_real"
      fi
    fi
  fi

  if [[ -d "$cache" ]]; then
    assert_owned_deletable_path "cache" "$cache" || return 1
    rm -rf "$cache"
  fi

  local scratch="${PACKET_VERIFY_ROOT}/scratch"
  if [[ -d "$scratch" ]]; then
    assert_owned_deletable_path "scratch" "$scratch" || return 1
    rm -rf "$scratch"
  fi

  if [[ -n "${PACKET_VERIFY_DELETE_ROOT:-}" && "$PACKET_VERIFY_DELETE_ROOT" == "1" ]]; then
    assert_owned_deletable_path "verify root" "$PACKET_VERIFY_ROOT" 1 || return 1
    local root_real
    root_real="$(realpath_safe "$PACKET_VERIFY_ROOT")"
    local deleted_any=0
    local entry
    for entry in "$root_real"/*; do
      [[ -e "$entry" ]] || continue
      local base
      base="$(basename "$entry")"
      if [[ "$base" == "artifacts" ]]; then
        continue
      fi
      rm -rf "$entry"
      deleted_any=1
    done
    if [[ "$deleted_any" -eq 0 ]]; then
      # cache/scratch were already removed above; nothing else left is not an error.
      echo "cleanup: PACKET_VERIFY_DELETE_ROOT=1: nothing else to remove under $root_real" >&2
    fi
  fi

  echo "cleanup: cache removed; artifacts preserved at $ARTIFACTS_DIR"
}

usage() {
  cat <<EOF
usage: control-packet <doctor|launch|env|cli|materialize-fixtures|fixture|make-scan|cleanup> [args]

Environment:
  PACKET_VERIFY_RUN_ID   unique run id (set before launch, or read from ownership marker)
  PACKET_VERIFY_ROOT     scratch root (default: /tmp/packet-verify-\$RUN_ID)
  PACKET_VERIFY_ARTIFACTS proof output dir (default: \$ROOT/artifacts)
  PACKET_VERIFY_CACHE    eval PDF cache (default: \$ROOT/cache)
  PACKET_VERIFY_CMD_LABEL basename for cli capture files (default: packet)
  PACKET_VERIFY_DELETE_ROOT when 1, remove non-artifacts under verify root (containment-checked)

cli -- runs packet and writes stdout/stderr/exitcode files; the subcommand exits with packet's code.
EOF
}

main() {
  local sub="${1:-}"
  establish_verify_paths "$sub"
  case "$sub" in
    doctor) shift; cmd_doctor "$@" ;;
    launch) shift; cmd_launch "$@" ;;
    cli) shift; cmd_cli "$@" ;;
    materialize-fixtures) shift; cmd_materialize_fixtures "$@" ;;
    fixture) shift; cmd_fixture "$@" ;;
    make-scan) shift; cmd_make_scan "$@" ;;
    cleanup) shift; cmd_cleanup "$@" ;;
    env) shift; cmd_env "$@" ;;
    -h|--help|"") usage ;;
    *) echo "unknown subcommand: $sub" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
